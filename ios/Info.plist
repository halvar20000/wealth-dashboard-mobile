<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The keys Xcode cannot generate from build settings. Everything
	     else (name, version, launch screen) comes from the target. -->

	<!-- A dashboard on the home network is often plain http at an IP
	     address or a .local name. Allow that, and only that: anything on
	     the internet still has to be https. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<key>NSLocalNetworkUsageDescription</key>
	<string>To reach the Wealth Dashboard you run on your own network.</string>

	<!-- The phone's own lock, borrowed when "Ask to unlock" is on. -->
	<key>NSFaceIDUsageDescription</key>
	<string>To keep the figures behind the phone's own lock.</string>

	<!-- Long-press on the icon: straight into the triage. -->
	<key>UIApplicationShortcutItems</key>
	<array>
		<dict>
			<key>UIApplicationShortcutItemType</key>
			<string>fr.smarthomeworld.wealth.triage</string>
			<key>UIApplicationShortcutItemTitle</key>
			<string>Triage</string>
			<key>UIApplicationShortcutItemSubtitle</key>
			<string>Sort what is waiting</string>
			<key>UIApplicationShortcutItemIconSymbolName</key>
			<string>rectangle.stack</string>
		</dict>
	</array>

	<!-- The background round (Round.swift): a refresh every few hours,
	     when iOS allows, and only when switched on in Settings. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>fr.smarthomeworld.wealth.round</string>
	</array>
	<key>UIBackgroundModes</key>
	<array>
		<string>fetch</string>
	</array>

	<!-- Only the system's own TLS: no export-compliance question on every
	     TestFlight upload. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
