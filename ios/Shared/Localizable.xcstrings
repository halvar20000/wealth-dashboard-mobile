          }
        }
      }
    },
    "The code is good for five minutes and for one device. The token it hands back lives in this phone's Keychain, and “Forget this dashboard” removes it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Code gilt fünf Minuten und für ein Gerät. Das Token, das er zurückgibt, liegt im Schlüsselbund dieses Telefons, und „Dieses Dashboard vergessen“ entfernt es."
          }
        }
      }
    },
    "The dashboard answered %lld." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Dashboard hat mit %lld geantwortet."
          }
        }
      }
    },
    "The dashboard could not sync. Open it to reconnect." : {
      "localizations" : {
        "de" : {
