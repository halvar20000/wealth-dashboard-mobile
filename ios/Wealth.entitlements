<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- One Keychain for the app, the widget and the share extension.
	     Listed first, it is where every new item goes. Keychain sharing
	     needs nothing registered in the developer portal. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.herbrig.wealthdashboard.shared</string>
	</array>
</dict>
</plist>
